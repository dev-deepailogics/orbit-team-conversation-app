# ==============================================
# Orbit Configuration Environment Variables
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# Database (PostgreSQL)
POSTGRES_USER=orbit_admin
POSTGRES_PASSWORD=orbit_secret_password
POSTGRES_DB=orbit_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://orbit_admin:orbit_secret_password@localhost:5432/orbit_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=orbit_redis_password
REDIS_URL="redis://:orbit_redis_password@localhost:6379"

# JWT Authentication
# REQUIRED in production (server refuses to start without a strong one). Generate: openssl rand -hex 48
JWT_SECRET="change-me"
# Access token lifetime (short). Sessions are kept alive by rotating refresh tokens stored (hashed) in the DB.
JWT_EXPIRES_IN="15m"
# Refresh token lifetime in days
REFRESH_TOKEN_DAYS=30

# LiveKit SFU (Huddle Audio / Video / Screen Share)
LIVEKIT_API_KEY="API_KEY_ORBIT"
LIVEKIT_API_SECRET="orbit_livekit_secret_key_change_in_production"
LIVEKIT_URL="http://localhost:7880"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# MinIO / S3 File Uploads
MINIO_ROOT_USER=minio_orbit_admin
MINIO_ROOT_PASSWORD=minio_orbit_secret_password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orbit-files
S3_ACCESS_KEY=minio_orbit_admin
S3_SECRET_KEY=minio_orbit_secret_password
S3_REGION=us-east-1

# Mobile push (FCM). Prod: single-line service-account JSON. Local: set the project id and run
# `gcloud auth application-default login` instead.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Sign in with Microsoft (Microsoft Entra ID) — see README "Sign in with Microsoft".
# Leave CLIENT_ID empty to disable. TENANT_ID: a tenant GUID, or common | organizations | consumers.
# Set to true in production to accept only Microsoft Entra ID sign-in (no passwords, no self-registration)
DISABLE_LOCAL_AUTH=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
