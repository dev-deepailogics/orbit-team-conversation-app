# ==============================================
# Orbit Configuration Environment Variables
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# Database (PostgreSQL)
POSTGRES_USER=orbit_admin
POSTGRES_PASSWORD=orbit_secret_password
POSTGRES_DB=orbit_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://orbit_admin:orbit_secret_password@localhost:5432/orbit_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=orbit_redis_password
REDIS_URL="redis://:orbit_redis_password@localhost:6379"

# JWT Authentication
JWT_SECRET="orbit_super_secret_jwt_access_token_key_1234567890"
JWT_REFRESH_SECRET="orbit_super_secret_jwt_refresh_token_key_0987654321"
JWT_EXPIRES_IN="7d"

# LiveKit SFU (Huddle Audio / Video / Screen Share)
LIVEKIT_API_KEY="API_KEY_ORBIT"
LIVEKIT_API_SECRET="orbit_livekit_secret_key_change_in_production"
LIVEKIT_URL="http://localhost:7880"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# MinIO / S3 File Uploads
MINIO_ROOT_USER=minio_orbit_admin
MINIO_ROOT_PASSWORD=minio_orbit_secret_password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orbit-files
S3_ACCESS_KEY=minio_orbit_admin
S3_SECRET_KEY=minio_orbit_secret_password
S3_REGION=us-east-1

# Mobile push (FCM). Prod: single-line service-account JSON. Local: set the project id and run
# `gcloud auth application-default login` instead.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
