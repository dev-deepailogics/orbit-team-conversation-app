generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
  IN_HUDDLE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
  GROUP_DIRECT
}

enum NotificationType {
  MENTION
  DIRECT_MESSAGE
  REACTION
  THREAD_REPLY
  HUDDLE_INVITE
  SYSTEM
}

enum SystemRole {
  SUPER_ADMIN
  WORKSPACE_ADMIN
  USER
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  username          String       @unique
  displayName       String
  avatarUrl         String?
  systemRole        SystemRole   @default(USER)
  status            UserStatus   @default(OFFLINE)
  customStatusText  String?
  customStatusEmoji String?
  
  // Organization, Leave & Integration Fields
  role                  String?      @default("employee")
  leaves                Json?        // e.g. { countLeaves: { casual: 10, sick: 8 }, offCountLeaves: { bereavement: 5, hajj: 15, ... } }
  disabled              Boolean      @default(false)
  isActive              Boolean      @default(true)
  usersCollectionFlags  Json?        // e.g. { disabled: false, isActive: true }
  slackThreadId         String?
  slackThreadExpiry     DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  channelMemberships ChannelMember[]
  messages          Message[]
  reactions         Reaction[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  huddlesHosted     Huddle[]          @relation("HuddleHost")
  createdBots       BotApp[]          @relation("BotCreator")
  createdWebhooks   Webhook[]         @relation("WebhookCreator")
  createdCommands   SlashCommand[]    @relation("CommandCreator")
  uploadedFiles     Attachment[]
  createdProjects   Project[]         @relation("ProjectCreator")
  createdTickets    Ticket[]          @relation("TicketCreator")
  assignedTickets   Ticket[]          @relation("TicketAssignee")
  createdDocuments  ProjectDocument[] @relation("DocumentCreator")
  documentShares    ProjectDocumentShare[]
  availabilities    UserAvailability[]
  ticketComments    TicketComment[]


  @@index([email])
  @@index([username])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  iconUrl     String?
  inviteCode  String   @unique @default(uuid())
  ownerId     String
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  channels    Channel[]
  projects    Project[]
  documents   ProjectDocument[]
  bots        BotApp[]
  webhooks    Webhook[]
  commands    SlashCommand[]
  notifications Notification[]
  huddles     Huddle[]
  attachments Attachment[]

  @@index([slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  nickname    String?
  settings    Json?
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  topic       String?
  description String?
  type        ChannelType @default(PUBLIC)
  isArchived  Boolean     @default(false)
  isAnonymous Boolean     @default(false)
  whiteboardData Json?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]
  webhooks    Webhook[]
  huddles     Huddle[]
  attachments Attachment[]
  projectNotifications Project[] @relation("ProjectNotificationChannel")

  @@index([workspaceId])
  @@index([type])
}

model ChannelMember {
  id         String    @id @default(uuid())
  channelId  String
  userId     String
  anonName   String?
  anonEmoji  String?
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now())

  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Message {
  id              String      @id @default(uuid())
  channelId       String
  userId          String?
  botAppId        String?
  parentMessageId String?
  quotedMessageId String?
  anonName        String?
  anonEmoji       String?
  content         String      @db.Text
  isEdited        Boolean     @default(false)
  isDeleted       Boolean     @default(false)
  isPinned        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bot             BotApp?     @relation(fields: [botAppId], references: [id], onDelete: SetNull)
  parentMessage   Message?    @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[]   @relation("MessageThread")
  quotedMessage   Message?    @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy        Message[]   @relation("MessageQuote")
  attachments     Attachment[]
  reactions       Reaction[]

  @@index([channelId, createdAt])
  @@index([parentMessageId])
  @@index([quotedMessageId])
  @@index([userId])
}

model Attachment {
  id              String    @id @default(uuid())
  workspaceId     String
  channelId       String?
  messageId       String?
  uploaderId      String?
  fileName        String
  fileKey         String
  fileUrl         String
  fileType        String
  fileSize        Int
  storageProvider String    @default("LOCAL")
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  message         Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader        User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isDeleted])
  @@index([channelId, isDeleted])
  @@index([messageId])
  @@index([uploaderId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  type        NotificationType
  title       String
  body        String
  read        Boolean          @default(false)
  linkUrl     String?
  channelId   String?
  messageId   String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId])
}

model Huddle {
  id          String    @id @default(uuid())
  channelId   String
  workspaceId String
  hostUserId  String
  isActive    Boolean   @default(true)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host        User      @relation("HuddleHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([channelId, isActive])
  @@index([workspaceId])
}

model BotApp {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  description String?
  avatarUrl   String?
  botToken    String         @unique
  scopes      String[]       @default(["chat:write"])
  isActive    Boolean        @default(true)
  createdById String
  createdAt   DateTime       @default(now())

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User           @relation("BotCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]
  commands    SlashCommand[]

  @@index([workspaceId])
  @@index([botToken])
}

model SlashCommand {
  id          String    @id @default(uuid())
  workspaceId String
  botAppId    String?
  command     String    // e.g. "/poll"
  description String?
  requestUrl  String
  createdById String
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot         BotApp?   @relation(fields: [botAppId], references: [id], onDelete: Cascade)
  creator     User      @relation("CommandCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, command])
  @@index([workspaceId])
}

model Webhook {
  id          String    @id @default(uuid())
  channelId   String
  workspaceId String
  name        String
  token       String    @unique @default(uuid())
  createdById String
  createdAt   DateTime  @default(now())

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([channelId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String          @id @default(uuid())
  workspaceId String
  name        String
  description String?
  icon        String?         @default("📋")
  color       String?         @default("#007A5A")
  notificationChannelId String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Firebase imported fields
  projectId         String?
  status            String?         @default("active")
  assignedEmployees Json?
  selectedManagers  Json?
  slackMentions     Json?
  clientUid         String?
  clientUsername    String?
  clientEmail       String?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  notificationChannel Channel?  @relation("ProjectNotificationChannel", fields: [notificationChannelId], references: [id], onDelete: SetNull)
  columns     ProjectColumn[]
  tickets     Ticket[]
  documents   ProjectDocument[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([notificationChannelId])
}

model ProjectColumn {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  color      String?  @default("#6B7280")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@index([projectId, orderIndex])
}

model Ticket {
  id          String         @id @default(uuid())
  projectId   String
  columnId    String
  title       String
  description String?        @db.Text
  priority    TicketPriority @default(MEDIUM)
  orderIndex  Int            @default(0)
  dueDate     DateTime?
  createdById String
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Firebase kanban_issues imported fields
  issueNumber Int?
  customId    String?
  dueTime     String?
  range       Int?
  gitbranch   String?
  labels      Json?
  assignees   Json?
  images      Json?
  events      Json?
  checklist   Json?
  storyPoints Int?
  timeSpent   Int?
  watchers    Json?
  notes       String?        @db.Text
  testPlan    String?        @db.Text
  loom        String?
  status      String?

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      ProjectColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator     User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TicketComment[]

  @@index([projectId])
  @@index([columnId, orderIndex])
  @@index([assigneeId])
}

model ProjectDocument {
  id                  String                 @id @default(uuid())
  projectId           String
  workspaceId         String
  title               String                 @default("Untitled")
  content             String                 @db.Text
  icon                String?                @default("📄")
  coverImage          String?
  isPublicInProject   Boolean                @default(false)
  createdById         String
  shareToken          String?                @unique @default(uuid())
  isPublicLinkEnabled Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             User                   @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  shares              ProjectDocumentShare[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([shareToken])
}

model ProjectDocumentShare {
  id          String          @id @default(uuid())
  documentId  String
  userId      String
  permission  String          @default("EDIT") // "VIEW" | "EDIT"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  document    ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}


model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// Employee Availability & Time Tracking Models
// ==========================================
model UserAvailability {
  id                    String              @id @default(uuid())
  userId                String
  date                  String              // YYYY-MM-DD
  availableTime         DateTime            @default(now())
  offTime               DateTime?
  totalWorkingMinutes   Int                 @default(0)
  isAvailable           Boolean             @default(true)
  isOnBreak             Boolean             @default(false)
  isAutoCheckedOut      Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks                AvailabilityBreak[]

  @@index([userId, date])
  @@index([userId, isAvailable])
}

model AvailabilityBreak {
  id                  String           @id @default(uuid())
  availabilityId      String
  uid                 String?
  breakReason         String           // Lunch, Namaz, Tea, Personal, etc.
  breakStartTime      DateTime         @default(now())
  availableAfterBreak DateTime?
  breakDurationMinutes Int             @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  availability        UserAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
}


model TicketComment {
  id            String    @id @default(uuid())
  ticketId      String
  userId        String?
  username      String?
  text          String    @db.Text
  type          String    @default("text")
  audioUrl      String?
  audioDuration Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId])
}

// FCM registration tokens for the mobile app (web uses PushSubscription).
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
