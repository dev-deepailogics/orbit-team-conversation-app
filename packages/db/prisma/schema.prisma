generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
  IN_HUDDLE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER // sees team availability, manages all projects
  HR // sees team availability (read-only)
  MEMBER // employee
  GUEST
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
  GROUP_DIRECT
}

enum NotificationPreference {
  ALL      // Notify on every new post (default)
  MENTIONS // Notify only when the user is @mentioned
  MUTED    // Never notify
}

enum NotificationType {
  MENTION
  DIRECT_MESSAGE
  REACTION
  THREAD_REPLY
  HUDDLE_INVITE
  SYSTEM
}

enum SystemRole {
  SUPER_ADMIN
  WORKSPACE_ADMIN
  USER
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String?      // null for users who only sign in via an external identity (e.g. Microsoft)
  username          String       @unique
  displayName       String
  avatarUrl         String?
  systemRole        SystemRole   @default(USER)
  status            UserStatus   @default(OFFLINE)
  customStatusText  String?
  customStatusEmoji String?
  
  // Organization, Leave & Integration Fields
  role                  String?      @default("employee")
  leaves                Json?        // e.g. { countLeaves: { casual: 10, sick: 8 }, offCountLeaves: { bereavement: 5, hajj: 15, ... } }
  disabled              Boolean      @default(false)
  isActive              Boolean      @default(true)
  usersCollectionFlags  Json?        // e.g. { disabled: false, isActive: true }
  slackThreadId         String?
  slackThreadExpiry     DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  channelMemberships ChannelMember[]
  messages          Message[]
  reactions         Reaction[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  huddlesHosted     Huddle[]          @relation("HuddleHost")
  createdBots       BotApp[]          @relation("BotCreator")
  createdWebhooks   Webhook[]         @relation("WebhookCreator")
  createdCommands   SlashCommand[]    @relation("CommandCreator")
  uploadedFiles     Attachment[]
  createdProjects   Project[]         @relation("ProjectCreator")
  createdTickets    Ticket[]          @relation("TicketCreator")
  assignedTickets   Ticket[]          @relation("TicketAssignee")
  createdDocuments  ProjectDocument[] @relation("DocumentCreator")
  documentShares    ProjectDocumentShare[]
  availabilities    UserAvailability[]
  ticketComments    TicketComment[]
  identities        UserIdentity[]
  pollVotes         PollVote[]
  refreshTokens     RefreshToken[]
  todos             Todo[]
  createdCanvases   Canvas[]          @relation("CanvasCreator")
  createdRecordings Recording[]       @relation("RecordingCreator")
  recordingViews    RecordingView[]

  @@index([email])
  @@index([username])
}

// Opaque, rotating refresh tokens (only the SHA-256 hash is stored). Every rotation keeps the same
// familyId; presenting an already-rotated token revokes the whole family (stolen-token detection).
// Personal quick to-dos: private to the user, not tied to a workspace.
model Todo {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  text      String
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done])
  @@map("todos")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  provider  String?   // sign-in method of the session (e.g. "microsoft"); carried into new access tokens
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// External sign-in identities (e.g. Microsoft Entra ID). Users are matched by
// (provider, providerUid) only — never by email.
model UserIdentity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String
  providerUid String   @map("provider_uid")
  email       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("user_identities")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  iconUrl     String?
  inviteCode  String   @unique @default(uuid())
  ownerId     String
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  channels    Channel[]
  projects    Project[]
  documents   ProjectDocument[]
  bots        BotApp[]
  webhooks    Webhook[]
  commands    SlashCommand[]
  notifications Notification[]
  huddles     Huddle[]
  attachments Attachment[]
  canvases    Canvas[]
  recordings  Recording[]

  @@index([slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  nickname    String?
  settings    Json?
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  topic       String?
  description String?
  type        ChannelType @default(PUBLIC)
  isArchived  Boolean     @default(false)
  isAnonymous Boolean     @default(false)
  whiteboardData Json?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]
  webhooks    Webhook[]
  huddles     Huddle[]
  attachments Attachment[]
  projectNotifications Project[] @relation("ProjectNotificationChannel")
  canvases    Canvas[]
  recordings  Recording[]

  @@index([workspaceId])
  @@index([type])
}

model ChannelMember {
  id                     String                 @id @default(uuid())
  channelId              String
  userId                 String
  anonName               String?
  anonEmoji              String?
  joinedAt               DateTime               @default(now())
  lastReadAt             DateTime               @default(now())
  notificationPreference NotificationPreference @default(ALL)

  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Message {
  id              String      @id @default(uuid())
  channelId       String
  userId          String?
  botAppId        String?
  parentMessageId String?
  quotedMessageId String?
  anonName        String?
  anonEmoji       String?
  content         String      @db.Text
  isEdited        Boolean     @default(false)
  isDeleted       Boolean     @default(false)
  // Set only when someone other than the author deleted it (an admin), so the placeholder can say who. The name is
  // kept as written at the time so it still reads correctly if that account is later renamed or removed.
  deletedById     String?
  deletedByName   String?
  isPinned        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bot             BotApp?     @relation(fields: [botAppId], references: [id], onDelete: SetNull)
  parentMessage   Message?    @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[]   @relation("MessageThread")
  quotedMessage   Message?    @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy        Message[]   @relation("MessageQuote")
  attachments     Attachment[]
  reactions       Reaction[]
  recordings      Recording[]
  poll            Poll?

  @@index([channelId, createdAt])
  @@index([parentMessageId])
  @@index([quotedMessageId])
  @@index([userId])
}

model Attachment {
  id              String    @id @default(uuid())
  workspaceId     String
  channelId       String?
  messageId       String?
  uploaderId      String?
  fileName        String
  fileKey         String
  fileUrl         String
  fileType        String
  fileSize        Int
  storageProvider String    @default("LOCAL")
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  message         Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader        User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  recording       Recording?

  @@index([workspaceId, isDeleted])
  @@index([channelId, isDeleted])
  @@index([messageId])
  @@index([uploaderId])
}

// A screen/webcam/audio recording ("Orbit clip"). Wraps the uploaded video in
// an Attachment (reusing the existing storage pipeline) and adds the metadata
// and shareable-link semantics a recording needs: duration, thumbnail, a
// standalone share slug (so a clip can be viewed/shared before or without
// ever being dropped into a channel/message), and view count.
model Recording {
  id           String    @id @default(uuid())
  workspaceId  String
  channelId    String?
  messageId    String?
  creatorId    String?
  title        String    @default("Untitled recording")
  attachmentId String    @unique
  thumbnailUrl String?
  durationSec  Int?
  shareSlug    String    @unique @default(uuid())
  viewCount    Int       @default(0)
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  message      Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  creator      User?      @relation("RecordingCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  views        RecordingView[]

  @@index([workspaceId, isDeleted])
  @@index([channelId])
  @@index([messageId])
  @@index([shareSlug])
  @@index([creatorId])
}

// "Seen by" for a recording: one row per signed-in workspace member who played it (the creator excluded).
// Anonymous plays of the public link only bump Recording.viewCount.
model RecordingView {
  recordingId   String
  userId        String
  firstViewedAt DateTime  @default(now())
  lastViewedAt  DateTime  @default(now())
  plays         Int       @default(1)

  recording     Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recordingId, userId])
  @@index([userId])
}

// A poll posted as a channel message (the message's content holds a plain-text fallback for clients that don't render
// polls). Votes keep the voter so each person votes once and sees their own choice; in anonymous channels voters are
// never sent to clients, only counts (see apps/server/src/services/pollService.ts).
model Poll {
  id            String       @id @default(uuid())
  messageId     String       @unique
  question      String
  allowMultiple Boolean      @default(false)
  createdAt     DateTime     @default(now())

  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options       PollOption[]
  votes         PollVote[]
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  text      String
  position  Int

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([pollId, userId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  type        NotificationType
  title       String
  body        String
  read        Boolean          @default(false)
  linkUrl     String?
  channelId   String?
  messageId   String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId])
}

model Huddle {
  id          String    @id @default(uuid())
  channelId   String
  workspaceId String
  hostUserId  String
  isActive    Boolean   @default(true)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host        User      @relation("HuddleHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([channelId, isActive])
  @@index([workspaceId])
}

model BotApp {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  description String?
  avatarUrl   String?
  botToken    String         @unique
  scopes      String[]       @default(["chat:write"])
  isActive    Boolean        @default(true)
  createdById String
  createdAt   DateTime       @default(now())

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User           @relation("BotCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]
  commands    SlashCommand[]

  @@index([workspaceId])
  @@index([botToken])
}

model SlashCommand {
  id          String    @id @default(uuid())
  workspaceId String
  botAppId    String?
  command     String    // e.g. "/poll"
  description String?
  requestUrl  String
  createdById String
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bot         BotApp?   @relation(fields: [botAppId], references: [id], onDelete: Cascade)
  creator     User      @relation("CommandCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, command])
  @@index([workspaceId])
}

model Webhook {
  id          String    @id @default(uuid())
  channelId   String
  workspaceId String
  name        String
  token       String    @unique @default(uuid())
  createdById String
  createdAt   DateTime  @default(now())

  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([channelId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// What kind of work item a ticket is (Jira-style issue type)
enum TicketType {
  TASK
  BUG
  STORY
  EPIC
}

model Project {
  id          String          @id @default(uuid())
  workspaceId String
  name        String
  description String?
  icon        String?         @default("📋")
  color       String?         @default("#007A5A")
  notificationChannelId String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Firebase imported fields
  projectId         String?
  status            String?         @default("active")
  assignedEmployees Json?
  selectedManagers  Json?
  slackMentions     Json?
  clientUid         String?
  clientUsername    String?
  clientEmail       String?

  // Last ticket number issued in this project; tickets are numbered 1, 2, 3… per project
  ticketCounter     Int             @default(0)

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  notificationChannel Channel?  @relation("ProjectNotificationChannel", fields: [notificationChannelId], references: [id], onDelete: SetNull)
  columns     ProjectColumn[]
  tickets     Ticket[]
  documents   ProjectDocument[]
  canvases    Canvas[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([notificationChannelId])
}

model ProjectColumn {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  color      String?  @default("#6B7280")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@index([projectId, orderIndex])
}

model Ticket {
  id          String         @id @default(uuid())
  projectId   String
  columnId    String
  title       String
  description String?        @db.Text
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(TASK)
  orderIndex  Int            @default(0)
  dueDate     DateTime?
  createdById String
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Firebase kanban_issues imported fields
  issueNumber Int?
  customId    String?
  dueTime     String?
  range       Int?
  gitbranch   String?
  labels      Json?
  assignees   Json?
  images      Json?
  events      Json?
  checklist   Json?
  storyPoints Int?
  timeSpent   Int?
  watchers    Json?
  notes       String?        @db.Text
  testPlan    String?        @db.Text
  loom        String?
  status      String?

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      ProjectColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator     User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TicketComment[]

  @@index([projectId])
  @@index([columnId, orderIndex])
  @@index([assigneeId])
}

model ProjectDocument {
  id                  String                 @id @default(uuid())
  projectId           String?                // optional link; docs are workspace-level
  workspaceId         String
  title               String                 @default("Untitled")
  content             String                 @db.Text
  icon                String?                @default("📄")
  coverImage          String?
  isPublicInProject   Boolean                @default(false)
  createdById         String
  shareToken          String?                @unique @default(uuid())
  isPublicLinkEnabled Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             User                   @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  shares              ProjectDocumentShare[]

  @@index([projectId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([shareToken])
}

model ProjectDocumentShare {
  id          String          @id @default(uuid())
  documentId  String
  userId      String
  permission  String          @default("EDIT") // "VIEW" | "EDIT"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  document    ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}


model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// Employee Availability & Time Tracking Models
// ==========================================
model UserAvailability {
  id                    String              @id @default(uuid())
  userId                String
  date                  String              // YYYY-MM-DD
  availableTime         DateTime            @default(now())
  offTime               DateTime?
  totalWorkingMinutes   Int                 @default(0)
  isAvailable           Boolean             @default(true)
  isOnBreak             Boolean             @default(false)
  isAutoCheckedOut      Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks                AvailabilityBreak[]

  @@index([userId, date])
  @@index([userId, isAvailable])
}

model AvailabilityBreak {
  id                  String           @id @default(uuid())
  availabilityId      String
  uid                 String?
  breakReason         String           // Lunch, Namaz, Tea, Personal, etc.
  breakStartTime      DateTime         @default(now())
  availableAfterBreak DateTime?
  breakDurationMinutes Int             @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  availability        UserAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@index([availabilityId])
}


model TicketComment {
  id            String    @id @default(uuid())
  ticketId      String
  userId        String?
  username      String?
  text          String    @db.Text
  type          String    @default("text")
  audioUrl      String?
  audioDuration Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId])
}

model GoogleOAuth {
  id           String   @id @default("google_oauth")
  tokens       Json     // Stores access_token, refresh_token, scope, token_type, expiry_date
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model MediaFolder {
  id            String        @id @default(uuid())
  folderId      String        @unique // Google Drive Folder ID
  name          String
  projectId     String
  parentId      String?       // Google Drive Parent Folder ID
  isProjectRoot Boolean       @default(false)
  webViewLink   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  files         MediaFile[]

  @@index([projectId])
  @@index([parentId])
}

model MediaFile {
  id               String       @id // Google Drive File ID
  name             String
  originalFileName String
  fileNamePrefix   String?
  description      String?      @db.Text
  mimeType         String?
  size             BigInt?
  webViewLink      String?
  folderId         String
  folder           MediaFolder? @relation(fields: [folderId], references: [folderId], onDelete: Cascade)
  projectId        String
  projectTitle     String?
  shareAccess      String       @default("linkReady") // "linkReady" | "restricted"
  modifiedTime     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([folderId])
  @@index([projectId])
}

// FCM registration tokens for the mobile app (web uses PushSubscription).
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Collaborative whiteboard canvases. Workspace-scoped; optionally linked to one
// channel/DM or one project (many canvases can link to the same target).
model Canvas {
  id          String    @id @default(uuid())
  workspaceId String
  title       String    @default("Untitled canvas")
  data        Json?
  channelId   String?
  projectId   String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator     User      @relation("CanvasCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([channelId])
  @@index([projectId])
}

// Security audit trail: who did what, to what, from where, and whether it worked. Deliberately no foreign keys, so
// entries outlive the users and workspaces they describe. Every row is also written to stdout for the SIEM.
model AuditLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @map("created_at")
  action       String   // e.g. auth.login, workspace.member_role_change, file.download
  outcome      String   @default("success") // success | failure
  actorId      String?  @map("actor_id")
  actorLabel   String?  @map("actor_label") // email/username at the time (also set for failed sign-ins with no user)
  workspaceId  String?  @map("workspace_id")
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  ip           String?
  forwardedFor String?  @map("forwarded_for")
  userAgent    String?  @map("user_agent")
  metadata     Json?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}
